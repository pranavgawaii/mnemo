# --- Database ---
# Local docker-compose Postgres+pgvector.
DATABASE_URL=postgresql+psycopg://mnemo:mnemo@localhost:5432/mnemo

# --- API ---
# Single API key for v1. Sent by clients as: X-API-Key: <key>
MNEMO_API_KEY=dev-local-key-change-me

# --- Embeddings ---
# sentence-transformers model. If you change this you MUST update EMBEDDING_DIM
# below AND the Vector(...) dimension in the Alembic migration — they must match.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Scoring / decay ---
# Floor is high on purpose: decay must modulate ranking, not dominate it.
# See app/core/decay.py and benchmark/ for the measurement behind these values.
DECAY_HALF_LIFE_DAYS=180
DECAY_FLOOR=0.7

# --- Contradiction detection ---
CONTRADICTION_SIM_THRESHOLD=0.82

# --- Logging ---
# JSON lines by default; set LOG_JSON=false for human-readable local output.
LOG_JSON=true
LOG_LEVEL=info

# --- Background jobs ---
# The outbox worker runs in-process. Set false to run jobs from cron instead
# (mnemo jobs run --once).
JOB_WORKER_ENABLED=true

# --- Hardening ---
# JSON array of allowed origins. Empty means same-origin only (no CORS).
# CORS_ALLOW_ORIGINS=["https://mnemo.dev"]
# Reject request bodies larger than this many bytes with 413.
MAX_BODY_BYTES=1048576

# --- Rate limiting ---
# Per-API-key fixed-minute windows in Postgres. Opt-in: existing deployments
# and test suites keep working with it disabled.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=120

# --- Near-duplicate detection ---
# "flag" reports deduplicated_of in the response; "reject" answers 409; "off".
DEDUP_MODE=flag
DEDUP_THRESHOLD=0.97

# --- LLM contradiction verdict (optional) ---
# Empty = fast local heuristic only. Set to "openai" to confirm flagged pairs
# with an OpenAI-compatible chat model; failures defer to the heuristic.
CONTRADICTION_LLM_PROVIDER=
CONTRADICTION_LLM_API_KEY=
CONTRADICTION_LLM_BASE_URL=https://api.openai.com/v1
CONTRADICTION_LLM_MODEL=gpt-4o-mini
CONTRADICTION_LLM_TIMEOUT_SECONDS=10
