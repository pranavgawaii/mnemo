"use client";

import { useState } from "react";
import type { ReactNode } from "react";

/**
 * Landing Kit — navigation example.
 *
 * Fixed 64px bar, solid paper, one hairline, centred mark, one pill CTA.
 * Replace the placeholder mark with your logo and pass your own links.
 *
 * Rename to `.tsx` in the destination project.
 */

export type NavLink = {
  label: string;
  href: string;
  external?: boolean;
};

export type NavProps = {
  brand?: string;
  left?: NavLink[];
  right?: NavLink[];
  cta?: NavLink;
  /** A simple square placeholder. Replace with your logo component. */
  mark?: ReactNode;
};

const defaults: Required<Omit<NavProps, "mark">> = {
  brand: "YourProduct",
  left: [
    { label: "How it works", href: "/#how-it-works" },
    { label: "Features", href: "/#features" },
  ],
  right: [
    { label: "Pricing", href: "/#pricing" },
    { label: "GitHub", href: "https://github.com", external: true },
  ],
  cta: { label: "Read docs", href: "/docs" },
};

function Link({
  link,
  onClick,
  className = "",
}: {
  link: NavLink;
  onClick?: () => void;
  className?: string;
}) {
  return (
    <a
      href={link.href}
      onClick={onClick}
      target={link.external ? "_blank" : undefined}
      rel={link.external ? "noopener noreferrer" : undefined}
      className={`link-underline w-fit text-[13.5px] font-medium text-muted transition-colors hover:text-accent ${className}`}
    >
      {link.label}
    </a>
  );
}

function Cta({ link, onClick }: { link: NavLink; onClick?: () => void }) {
  return (
    <a
      href={link.href}
      onClick={onClick}
      target={link.external ? "_blank" : undefined}
      rel={link.external ? "noopener noreferrer" : undefined}
      className="group relative inline-flex h-9 shrink-0 items-center overflow-hidden rounded-full bg-[linear-gradient(180deg,#232331_0%,#0F0F18_55%,#0A0A0F_100%)] pl-3 pr-3.5 text-[13.5px] font-medium leading-none tracking-[-0.01em] text-[#FAFAFA] ring-1 ring-inset ring-white/15 shadow-[0_1px_2px_rgba(10,10,15,0.20),0_10px_24px_-12px_rgba(10,10,15,0.80),inset_0_1px_0_rgba(255,255,255,0.18)] transition-[transform,box-shadow] duration-300 ease-[cubic-bezier(.16,1,.3,1)] hover:-translate-y-px hover:shadow-[0_2px_4px_rgba(10,10,15,0.26),0_14px_30px_-12px_rgba(10,10,15,0.85),inset_0_1px_0_rgba(255,255,255,0.26)] active:translate-y-0 active:scale-[0.985] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:active:scale-100"
    >
      <span className="relative inline-flex items-center gap-[7px]">
        <svg className="h-[13px] w-[13px] shrink-0 text-white/75" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <rect x="2.9" y="1.7" width="8.2" height="10.6" rx="1.7" stroke="currentColor" strokeWidth="1.25" />
          <path d="M5.5 5.5h3M5.5 8.3h2.2" stroke="currentColor" strokeWidth="1.25" strokeLinecap="round" />
        </svg>
        {link.label}
        <svg className="h-[11px] w-[11px] shrink-0 text-white/70 transition-transform duration-300 group-hover:translate-x-[2.5px]" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2.6 6h6.1M6.3 3.6L8.7 6l-2.4 2.4" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round" />
        </svg>
      </span>
    </a>
  );
}

export function SiteNav({
  brand = defaults.brand,
  left = defaults.left,
  right = defaults.right,
  cta = defaults.cta,
  mark,
}: NavProps) {
  const [open, setOpen] = useState(false);
  const all = [...left, ...right];

  const logo = mark ?? (
    <span className="block h-6 w-6 rounded-md border border-ink/25" aria-hidden="true" />
  );

  return (
    <header className="fixed inset-x-0 top-0 z-50 border-b border-black/[0.07] bg-background">
      <nav aria-label="Primary" className="mx-auto h-16 max-w-frame px-6">
        {/* Desktop */}
        <div className="hidden h-full items-center lg:grid lg:grid-cols-[1fr_auto_1fr]">
          <a
            href="/"
            className="w-fit text-[19px] font-semibold tracking-tight text-ink transition-colors hover:text-accent"
          >
            {brand}
          </a>

          <div className="flex items-center gap-8">
            {left.map((link) => (
              <Link key={link.href} link={link} />
            ))}
            <a
              href="/"
              aria-label={`${brand} home`}
              className="flex items-center text-ink transition-colors hover:text-accent"
            >
              {logo}
            </a>
            {right.map((link) => (
              <Link key={link.href} link={link} />
            ))}
          </div>

          <div className="flex items-center justify-end">
            <Cta link={cta} />
          </div>
        </div>

        {/* Mobile */}
        <div className="flex h-full items-center justify-between lg:hidden">
          <a href="/" className="flex items-center gap-2.5 text-ink" aria-label={`${brand} home`}>
            {logo}
            <span className="text-[19px] font-semibold tracking-tight">{brand}</span>
          </a>

          <div className="flex items-center gap-2">
            <Cta link={cta} onClick={() => setOpen(false)} />
            <button
              type="button"
              aria-label={open ? "Close menu" : "Open menu"}
              aria-expanded={open}
              aria-controls="mobile-menu"
              onClick={() => setOpen((v) => !v)}
              className="-mr-1.5 flex h-9 w-9 items-center justify-center rounded-lg text-ink transition-colors hover:bg-black/[0.04]"
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                {open ? (
                  <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" />
                ) : (
                  <path d="M3 6h14M3 13h14" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" />
                )}
              </svg>
            </button>
          </div>
        </div>
      </nav>

      {open && (
        <div id="mobile-menu" className="border-t border-black/[0.07] bg-background px-6 py-5 lg:hidden">
          <div className="flex flex-col gap-4">
            {all.map((link) => (
              <Link key={link.href} link={link} onClick={() => setOpen(false)} />
            ))}
          </div>
        </div>
      )}
    </header>
  );
}
