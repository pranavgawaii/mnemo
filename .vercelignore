# The web deployment is the Next.js app at the repo root. Keep the API,
# Python env, tests and tooling out of the upload.
#
# Paths are anchored to the repo root: an unanchored `docs/` also matches
# `app/docs/`, which would remove the /docs route from the deployment.
/backend/
/sdk/
/landing-kit/
/.venv/
__pycache__/
*.pyc
.pytest_cache/
/tests/
/benchmark/
/docs/
/.github/
