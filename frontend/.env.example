# Optional: override the repository URL used by the nav / hero / footer CTAs.
# Defaults to https://github.com/pranavgawaii/mnemo when unset.
NEXT_PUBLIC_GITHUB_URL=https://github.com/pranavgawaii/mnemo

# Optional: canonical origin used by metadata, the sitemap and Open Graph URLs.
# Falls back to the domain Vercel assigns the project, then to localhost.
# NEXT_PUBLIC_SITE_URL=https://mnemo.dev
